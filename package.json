{
  "name": "@yaha/dsh-terminal",
  "version": "0.1.0",
  "description": "DSH Web 终端插件：右侧 8 列做上下 8/2 分区，下方 2 为系统交互终端（node-pty PTY + xterm.js），按钮弹出/隐藏，可拖拽调高度。Host 侧 node-pty 起 $SHELL，通过 WebSocket 双向流式；浏览器侧挂 xterm.js。命名带 yaha 便于管理。",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
